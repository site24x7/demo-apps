<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Site24x7 Chaos SDK, shipped in the repo-root chaos-libs/ folder -->
    <add key="chaos-libs" value="../../../../chaos-libs/dotnet" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="chaos-libs">
      <package pattern="Site24x7.Chaos" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
