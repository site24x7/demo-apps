# =============================================================================
# ZylkerKart Search Service — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/search-service.env and edit the values.
# The search service provides product search powered by MySQL + Redis caching.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8083

# ── MySQL (Search Database) ──────────────────────────────────────────────────
DB_HOST=MYSQL_SERVER_IP
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ZylkerKart@2024
DB_NAME=db_search

# ── Redis (Cache) ────────────────────────────────────────────────────────────
REDIS_HOST=REDIS_SERVER_IP
REDIS_PORT=6379

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=search-service
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Tuning (Optional) ───────────────────────────────────────────────────────
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# GIN_MODE=release

# ── Site24x7 APM (Optional) ─────────────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=

# ── Site24x7 OpenTelemetry (Optional) ───────────────────────────────────────
# Mutually exclusive with S247_APM_ENABLED. License key is sent as the OTLP
# `Api-Key` header. Pick the regional endpoint matching your datacenter.
# S247_OTEL_ENABLED=false
# S247_LICENSE_KEY=
# OTEL_SERVICE_NAME=ZylkerKart-Search
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.site24x7.com:443
# OTEL_EXPORTER_OTLP_HEADERS=Api-Key=${S247_LICENSE_KEY}
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=service.name=ZylkerKart-Search,service.version=1.0.0,deployment.environment=baremetal
