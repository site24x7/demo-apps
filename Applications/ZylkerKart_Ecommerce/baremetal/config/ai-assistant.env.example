# =============================================================================
# ZylkerKart AI Assistant — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/ai-assistant.env and edit the values.
# The AI assistant provides a shopping chat interface backed by a pluggable LLM.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8086

# ── Backend Service URLs ─────────────────────────────────────────────────────
PRODUCT_SERVICE_URL=http://PRODUCT_SERVER_IP:8081
ORDER_SERVICE_URL=http://ORDER_SERVER_IP:8082
SEARCH_SERVICE_URL=http://SEARCH_SERVER_IP:8083

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: ollama | openai | anthropic | azure | groq | compatible
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:latest

# Ollama (local) — point to wherever Ollama is running
LLM_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# OpenAI (set LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Anthropic (set LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-20250514

# Groq (set LLM_PROVIDER=groq)
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# Azure OpenAI (set LLM_PROVIDER=azure)
# AZURE_API_KEY=
# AZURE_API_BASE=https://<resource>.openai.azure.com
# LLM_MODEL=<deployment-name>
# LLM_API_VERSION=2024-08-01-preview

# ── Security ─────────────────────────────────────────────────────────────────
# Shared secret between storefront and ai-assistant. Must match storefront's AI_INTERNAL_TOKEN.
AI_INTERNAL_TOKEN=change-me-in-production

# ── Agent ────────────────────────────────────────────────────────────────────
AI_MAX_TOOL_ROUNDS=4

# ── Site24x7 LLM Observability (Optional) ────────────────────────────────────
OTEL_SERVICE_NAME=zylkerkart-ai-assistant
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.site24x7rum.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=api-key=<your-site24x7-license-key>

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=ai-assistant
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults
