# =============================================================================
# ZylkerKart Order Service — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/order-service.env and edit the values.
# The order service handles cart and order management.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8082

# ── MySQL (Order Database) ───────────────────────────────────────────────────
DB_HOST=MYSQL_SERVER_IP
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ZylkerKart@2024
DB_NAME=db_order

# ── Redis (Cart Store) ──────────────────────────────────────────────────────
REDIS_HOST=REDIS_SERVER_IP
REDIS_PORT=6379

# ── Dependent Services ──────────────────────────────────────────────────────
PAYMENT_SERVICE_URL=http://PAYMENT_SERVER_IP:8084
AUTH_SERVICE_URL=http://AUTH_SERVER_IP:8085

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=order-service
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Site24x7 APM (Optional) ─────────────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=
# APMINSIGHT_LICENSE_KEY=
# APMINSIGHT_APP_NAME=ZylkerKart-Order
# APMINSIGHT_APP_PORT=8082
