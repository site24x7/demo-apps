# =============================================================================
# ZylkerKart Storefront — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/storefront.env and edit the values.
# The storefront is the BFF (Backend For Frontend) that aggregates all
# backend microservices and serves the Thymeleaf web UI.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# SERVER_PORT=80  (app defaults to 80 in application.properties)

# ── Backend Service URLs ─────────────────────────────────────────────────────
# Replace hostnames/IPs with your actual server addresses
PRODUCT_SERVICE_URL=http://PRODUCT_SERVER_IP:8081
ORDER_SERVICE_URL=http://ORDER_SERVER_IP:8082
SEARCH_SERVICE_URL=http://SEARCH_SERVER_IP:8083
PAYMENT_SERVICE_URL=http://PAYMENT_SERVER_IP:8084
AUTH_SERVICE_URL=http://AUTH_SERVER_IP:8085

# ── Redis (Session Store) ───────────────────────────────────────────────────
REDIS_HOST=REDIS_SERVER_IP
REDIS_PORT=6379

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=storefront
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Site24x7 APM / RUM (Optional) ───────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=
# SITE24X7_RUM_KEY=

# ── Site24x7 OpenTelemetry (Optional) ───────────────────────────────────────
# Mutually exclusive with S247_APM_ENABLED. License key is sent as the OTLP
# `Api-Key` header. Pick the regional endpoint matching your datacenter.
# S247_OTEL_ENABLED=false
# S247_LICENSE_KEY=
# OTEL_SERVICE_NAME=ZylkerKart-Storefront
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.site24x7.com:443
# OTEL_EXPORTER_OTLP_HEADERS=Api-Key=${S247_LICENSE_KEY}
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_RESOURCE_ATTRIBUTES=service.name=ZylkerKart-Storefront,service.version=1.0.0,deployment.environment=baremetal
