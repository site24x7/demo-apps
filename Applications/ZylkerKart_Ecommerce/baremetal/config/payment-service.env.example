# =============================================================================
# ZylkerKart Payment Service — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/payment-service.env and edit the values.
# The payment service processes payments using MySQL for transaction storage.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8084

# ── MySQL (Payment Database) ─────────────────────────────────────────────────
DB_HOST=MYSQL_SERVER_IP
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ZylkerKart@2024
DB_NAME=db_payment

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=payment-service
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Site24x7 APM (Optional) ─────────────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=
# APM_APP_NAME=ZylkerKart-Payment
