# =============================================================================
# ZylkerKart MySQL — Setup Configuration
# =============================================================================
# Copy this file to mysql.env (same directory as setup-mysql.sh) and edit.
# Used by setup-mysql.sh to create databases, users, and seed data.
# =============================================================================

# ── MySQL Root Credentials ───────────────────────────────────────────────────
# The root password of your existing MySQL 8.0 installation.
MYSQL_ROOT_PASSWORD=ZylkerKart@2024

# ── MySQL Connection ─────────────────────────────────────────────────────────
# If setup-mysql.sh runs on the MySQL server itself, use localhost.
# Otherwise, set the remote MySQL server IP.
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ── Application Database User (Optional) ─────────────────────────────────────
# If you want a dedicated app user instead of using root:
# APP_DB_USER=zylkerkart
# APP_DB_PASSWORD=ZylkerKartApp@2024
# When set, setup-mysql.sh will create this user with grants on all 5 databases.
