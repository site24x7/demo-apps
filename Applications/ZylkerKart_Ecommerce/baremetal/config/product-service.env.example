# =============================================================================
# ZylkerKart Product Service — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/product-service.env and edit the values.
# The product service manages the product catalog with MySQL + Redis caching.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# SERVER_PORT=8081  (app defaults to 8081 in application.yml)

# ── MySQL (Product Database) ─────────────────────────────────────────────────
# The application.yml builds the JDBC URL from these env vars:
#   jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/db_product
MYSQL_HOST=MYSQL_SERVER_IP
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=ZylkerKart@2024

# ── Redis (Cache) ────────────────────────────────────────────────────────────
REDIS_HOST=REDIS_SERVER_IP
REDIS_PORT=6379

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=product-service
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Site24x7 APM (Optional) ─────────────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=
