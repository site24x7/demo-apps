# =============================================================================
# ZylkerKart Auth Service — Environment Configuration
# =============================================================================
# Copy this file to /etc/zylkerkart/auth-service.env and edit the values.
# The auth service handles JWT authentication and user management.
# NOTE: This service requires amd64 architecture (x86_64).
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8085

# ── MySQL (Auth Database) ────────────────────────────────────────────────────
DB_HOST=MYSQL_SERVER_IP
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ZylkerKart@2024
DB_NAME=db_auth

# ── JWT Configuration ────────────────────────────────────────────────────────
JWT_SECRET=ZylkerKart-Super-Secret-JWT-Key-2024-Must-Be-At-Least-32-Chars
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Chaos SDK (Optional) ────────────────────────────────────────────────────
CHAOS_SDK_ENABLED=false
CHAOS_SDK_APP_NAME=auth-service
CHAOS_SDK_CONFIG_DIR=/var/site24x7-labs/faults

# ── Site24x7 APM (Optional) ─────────────────────────────────────────────────
# S247_APM_ENABLED=false
# S247_LICENSE_KEY=
# SITE24X7_APP_NAME=ZylkerKart-Auth
