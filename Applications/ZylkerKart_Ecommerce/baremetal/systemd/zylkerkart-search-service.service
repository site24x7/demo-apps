# =============================================================================
# ZylkerKart Search Service — Go 1.21 / Gin (Static Binary)
# Port: 8083
# Prerequisites: None (self-contained binary)
# =============================================================================

[Unit]
Description=ZylkerKart Search Service (Go/Gin)
Documentation=https://github.com/site24x7/demo-apps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zylkerkart
Group=zylkerkart

WorkingDirectory=/opt/zylkerkart/search-service
EnvironmentFile=/etc/zylkerkart/search-service.env

ExecStart=/opt/zylkerkart/search-service/search-service

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zylkerkart/search-service /var/site24x7-labs
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zylkerkart-search-service

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
