# =============================================================================
# ZylkerKart Storefront — Java 17 / Spring Boot BFF
# Port: 80
# Prerequisites: Eclipse Temurin JRE 17+
# =============================================================================

[Unit]
Description=ZylkerKart Storefront (Spring Boot BFF)
Documentation=https://github.com/site24x7/demo-apps
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zylkerkart
Group=zylkerkart

WorkingDirectory=/opt/zylkerkart/storefront
EnvironmentFile=/etc/zylkerkart/storefront.env

ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar /opt/zylkerkart/storefront/app.jar

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zylkerkart/storefront /var/site24x7-labs
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zylkerkart-storefront

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
